{
  "name": "@archastro/intern-mcp",
  "version": "0.3.0",
  "description": "Local MCP server for building and publishing TryIntern sites",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "intern-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tryintern",
    "codex",
    "claude",
    "grok",
    "cursor",
    "opencode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArchAstro/intern-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ArchAstro/intern-mcp/issues"
  },
  "homepage": "https://tryintern.dev",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:runtime-contract": "node scripts/runtime-contract.mjs check",
    "check": "npm run format:check && npm run lint && npm run build && npm test && npm run test:package && npm run test:sdk",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepack": "npm run build",
    "test:harnesses": "node scripts/harness-install-smoke.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "test:sdk": "node scripts/sdk-compatibility.mjs",
    "test": "vitest run",
    "start": "node dist/index.js serve"
  },
  "dependencies": {
    "@archastro/intern-sdk": "0.1.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "^22",
    "eslint": "9.39.2",
    "globals": "16.5.0",
    "playwright-core": "^1.61.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.8"
  }
}
